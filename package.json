{
  "name": "videohealth",
  "version": "0.1.0",
  "private": true,
  "description": "VideoHealth — experimental telemedicine app on Amazon Chime SDK",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @videohealth/web",
    "build:web": "npm run build -w @videohealth/web",
    "build:api": "npm run build -w @videohealth/api",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
